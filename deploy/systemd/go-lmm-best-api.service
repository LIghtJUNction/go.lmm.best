[Unit]
Description=go.lmm.best API service
Documentation=file:/opt/go-lmm-best/current/docs/backend-deployment.md
After=network.target
StartLimitIntervalSec=30s
StartLimitBurst=5

[Service]
Type=simple
DynamicUser=yes
StateDirectory=go-lmm-best
StateDirectoryMode=0750
WorkingDirectory=/var/lib/go-lmm-best

Environment=HOST=127.0.0.1
Environment=PORT=8787
Environment=APP_ORIGIN=https://go.lmm.best
Environment=DATABASE_PATH=/var/lib/go-lmm-best/go.sqlite3
Environment=MAX_STORED_SHARES=10000
Environment=MAX_SPECTATORS_PER_SHARE=50
Environment=MAX_SPECTATORS_GLOBAL=1000
EnvironmentFile=-/etc/go-lmm-best-api.env
ExecStart=/opt/go-lmm-best/bin/go-lmm-best-api

Restart=on-failure
RestartSec=3s
TimeoutStartSec=30s
TimeoutStopSec=30s
KillSignal=SIGTERM
LimitNOFILE=65536
UMask=0027

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
LockPersonality=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
AmbientCapabilities=
SocketBindDeny=any
SocketBindAllow=tcp:8787
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
